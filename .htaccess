# Orderly — Apache security & caching (use if hosted on Apache)
Options -Indexes

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # CSP: allow self + Google Fonts; tighten further if you add analytics domains
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Block sensitive / unnecessary paths
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git - [F,L]
  RewriteRule ^assets/legal_texts_all_languages\.md$ - [F,L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Protect against MIME sniffing on APK
<FilesMatch "\.(apk)$">
  <IfModule mod_headers.c>
    Header set Content-Type "application/vnd.android.package-archive"
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Disposition "attachment"
  </IfModule>
</FilesMatch>
